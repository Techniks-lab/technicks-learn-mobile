    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-secure-store": "^57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-react-query-devtools": "^1.5.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "openapi-typescript-codegen": "^0.31.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "generate_auth:sdk": "openapi-generator-cli generate -g typescript-axios -i http://localhost:3000/docs/auth.json -o src/sdk/auth --additional-properties=supportsES6=true,npmName=org --skip-validate-spec",
    "generate_blog:sdk": "openapi-generator-cli generate -g typescript-axios -i http://localhost:3000/docs/Blog.json -o src/sdk/blog --additional-properties=supportsES6=true,npmName=org --skip-validate-spec",
    "generate_blog_categories:sdk": "openapi-generator-cli generate -g typescript-axios -i http://localhost:3000/docs/Blog%20Categories.json -o src/sdk/blog-categories --additional-properties=supportsES6=true,npmName=org --skip-validate-spec",
    "generate_learn:sdk": "openapi-generator-cli generate -g typescript-axios -i http://localhost:3000/docs/Learn.json -o src/sdk/learn --additional-properties=supportsES6=true,npmName=org --skip-validate-spec",
    "generate_courses:sdk": "openapi-generator-cli generate -g typescript-axios -i http://localhost:3000/docs/Courses.json -o src/sdk/courses --additional-properties=supportsES6=true,npmName=org --skip-validate-spec",
    "generate_gamification:sdk": "openapi-generator-cli generate -g typescript-axios -i http://localhost:3000/docs/Gamification.json -o src/sdk/gamification --additional-properties=supportsES6=true,npmName=org --skip-validate-spec"
  },
  "private": true
}
